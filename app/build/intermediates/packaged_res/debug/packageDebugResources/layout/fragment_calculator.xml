<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                   

    

           

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        tools:context=".ui.calculator.CalculatorFragment" android:tag="layout/fragment_calculator_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculator"
            android:textAppearance="?attr/textAppearanceHeadline5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/desktop_pc_builder_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Armar un PC de Escritorio" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/laptop_configurator_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Configurar un Portátil" />

    </LinearLayout>
         