<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                   

    

           

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.calculator.DesktopPcBuilderFragment" android:tag="layout/fragment_desktop_pc_builder_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arma tu PC de Escritorio"
                android:textAppearance="?attr/textAppearanceHeadline5" />

            <!-- Motherboard -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tarjeta Madre" />

            <Spinner
                android:id="@+id/motherboard_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Processor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Procesador" />

            <Spinner
                android:id="@+id/processor_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- RAM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Memoria RAM" />

            <Spinner
                android:id="@+id/ram_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Storage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Almacenamiento" />

            <Spinner
                android:id="@+id/storage_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- GPU -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tarjeta de Video" />

            <Spinner
                android:id="@+id/gpu_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Total Price -->
            <TextView
                android:id="@+id/total_price_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Precio Total: $0.00"
                android:textAppearance="?attr/textAppearanceHeadline6" />

        </LinearLayout>
    </ScrollView>
         