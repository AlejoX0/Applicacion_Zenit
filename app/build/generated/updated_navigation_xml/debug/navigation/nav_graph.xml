<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/loginFragment" >
<fragment
    android:id="@+id/loginFragment"
    android:name="com.zenit.digital.ui.login.LoginFragment"
    android:label="fragment_login"
    tools:layout="@layout/fragment_login" >

    <action
        android:id="@+id/action_loginFragment_to_mainFragment"
        app:destination="@id/mainFragment" />

</fragment>
<fragment
    android:id="@+id/mainFragment"
    android:name="com.zenit.digital.ui.main.MainFragment"
    android:label="fragment_main"
    tools:layout="@layout/fragment_main" >

    <action
        android:id="@+id/action_mainFragment_to_mainTopicFragment"
        app:destination="@id/mainTopicFragment" />
    <action
        android:id="@+id/action_mainFragment_to_missionFragment"
        app:destination="@id/missionFragment" />
    <action
        android:id="@+id/action_mainFragment_to_aboutUsFragment"
        app:destination="@id/aboutUsFragment" />
    <action
        android:id="@+id/action_mainFragment_to_catalogFragment"
        app:destination="@id/catalogFragment" />
    <action
        android:id="@+id/action_mainFragment_to_galleryFragment"
        app:destination="@id/galleryFragment" />
    <action
        android:id="@+id/action_mainFragment_to_videoFragment"
        app:destination="@id/videoFragment" />
    <action
        android:id="@+id/action_mainFragment_to_contactFragment"
        app:destination="@id/contactFragment" />
    <action
        android:id="@+id/action_mainFragment_to_socialFragment"
        app:destination="@id/socialFragment" />
    <action
        android:id="@+id/action_mainFragment_to_calculatorFragment"
        app:destination="@id/calculatorFragment" />

</fragment>
<fragment
    android:id="@+id/mainTopicFragment"
    android:name="com.zenit.digital.ui.maintopic.MainTopicFragment"
    android:label="fragment_main_topic"
    tools:layout="@layout/fragment_main_topic" />
<fragment
    android:id="@+id/missionFragment"
    android:name="com.zenit.digital.ui.mission.MissionFragment"
    android:label="fragment_mission"
    tools:layout="@layout/fragment_mission" />
<fragment
    android:id="@+id/aboutUsFragment"
    android:name="com.zenit.digital.ui.aboutus.AboutUsFragment"
    android:label="fragment_about_us"
    tools:layout="@layout/fragment_about_us" />
<fragment
    android:id="@+id/catalogFragment"
    android:name="com.zenit.digital.ui.catalog.CatalogFragment"
    android:label="fragment_catalog"
    tools:layout="@layout/fragment_catalog" />
<fragment
    android:id="@+id/galleryFragment"
    android:name="com.zenit.digital.ui.gallery.GalleryFragment"
    android:label="fragment_gallery"
    tools:layout="@layout/fragment_gallery" />
<fragment
    android:id="@+id/videoFragment"
    android:name="com.zenit.digital.ui.video.VideoFragment"
    android:label="fragment_video"
    tools:layout="@layout/fragment_video" />
<fragment
    android:id="@+id/contactFragment"
    android:name="com.zenit.digital.ui.contact.ContactFragment"
    android:label="fragment_contact"
    tools:layout="@layout/fragment_contact" />
<fragment
    android:id="@+id/socialFragment"
    android:name="com.zenit.digital.ui.social.SocialFragment"
    android:label="fragment_social"
    tools:layout="@layout/fragment_social" />
<fragment
    android:id="@+id/calculatorFragment"
    android:name="com.zenit.digital.ui.calculator.CalculatorFragment"
    android:label="fragment_calculator"
    tools:layout="@layout/fragment_calculator" />
</navigation>